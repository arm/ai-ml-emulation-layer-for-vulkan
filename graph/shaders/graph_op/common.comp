// Truncation per rule: take top 16 bits of fp32
bfloat16_t encode_from_f32_trunc(float x)
{
    uint u = floatBitsToUint(x);
    return bfloat16_t(u >> 16);
}

bfloat16_t encode_from_f32_trunc(float x, bfloat16_t)
{
    return encode_from_f32_trunc(x);
}

// Round directly from FP32 to FP8, including subnormals and non-saturating
// overflow. Going through FP16 can round across an FP8 midpoint first.
uint8_t encode_float8_rne(float x, uint typeTag)
{
    uint bits = floatBitsToUint(x);
    uint sign = (bits >> 24) & 0x80u;
    uint exponent = (bits >> 23) & 0xffu;
    uint fraction = bits & 0x7fffffu;
    bool e4m3 = typeTag == TYPE_FLOAT8_E4M3;
    uint overflow = e4m3 ? 0x7fu : 0x7cu;
    if (exponent == 0xffu) {
        return uint8_t(sign | (fraction != 0u ? 0x7fu : overflow));
    }
    uint mantissaBits = e4m3 ? 3u : 2u;
    int targetExponent = int(exponent) - 127 + (e4m3 ? 7 : 15);
    if (targetExponent > (e4m3 ? 15 : 30)) {
        return uint8_t(sign | overflow);
    }
    uint shift = 23u - mantissaBits;
    uint significand = fraction;
    uint result;
    if (targetExponent <= 0) {
        shift += uint(1 - targetExponent);
        if (shift > 24u) {
            return uint8_t(sign);
        }
        significand |= 0x800000u;
        result = significand >> shift;
    } else {
        result = (uint(targetExponent) << mantissaBits) | (significand >> shift);
    }
    uint remainder = significand & ((1u << shift) - 1u);
    uint halfway = 1u << (shift - 1u);
    if (remainder > halfway || (remainder == halfway && (result & 1u) != 0u)) {
        result++;
    }
    return uint8_t(sign | min(result, overflow));
}

float16_t encode_from_f32_trunc(float x, float16_t)
{
    return float16_t(x);
}

// Round-to-nearest-even conversion with Inf/NaN handling preserved.
bfloat16_t f32_to_bf16_rne(float x)
{
    uint u = floatBitsToUint(x);
    uint exp = u & 0x7F800000u;
    uint mantissa = u & 0x007FFFFFu;

    if (exp == 0x7F800000u) {
        if (mantissa != 0u) {
            return bfloat16_t((u >> 16) | 0x0040u);
        }
        return bfloat16_t(u >> 16);
    }

    uint lsb = (u >> 16) & 1u;
    u += 0x7FFFu + lsb;
    return bfloat16_t(u >> 16);
}

bfloat16_t encode_from_f32_rne(float x)
{
    return f32_to_bf16_rne(x);
}

bfloat16_t encode_from_f32_rne(float x, bfloat16_t)
{
