// Maximum supported rank
#define RANK_MAX 6

#define NAN (0.0 / 0.0)
#define INF (1.0 / 0.0)
#define PI 3.141592653589793238462643383279502884197

// NAN Modes
#define NAN_MODE_PROPAGATE 1
#define NAN_MODE_IGNORE 2

// Types
#define TYPE_BOOL 0x6231   // "b1"
#define TYPE_INT8 0x6931   // "i1"
#define TYPE_INT16 0x6932  // "i2"
#define TYPE_INT32 0x6934  // "i4"
#define TYPE_INT64 0x6938  // "i8"
#define TYPE_UINT32 0x7534 // "u4"
#define TYPE_UINT8 0x7531  // "u1"
#define TYPE_HALF 0x6632   // "f2"
#define TYPE_FLOAT 0x6634  // "f4"
#define TYPE_BFLOAT16 0x6642 // "fB"
#define TYPE_FLOAT8_E5M2 0x664D // "fM"
#define TYPE_FLOAT8_E4M3 0x664E // "fN"
#define TYPE_DOUBLE 0x6638 // "f8"

// Bfloat type
#define bfloat16_t uint16_t
#define float8_e4m3_t uint8_t
#define float8_e5m2_t uint8_t

#define IS_BOOL(t) (t == TYPE_BOOL)
#define IS_INTEGER(t) ((t >> 8) == 0x69)
#define IS_FLOAT8(t) ((t == TYPE_FLOAT8_E5M2) || (t == TYPE_FLOAT8_E4M3))
#define IS_FLOAT(t) ((t == TYPE_HALF) || (t == TYPE_FLOAT))
#define IS_BFLOAT(t) (t == TYPE_BFLOAT16)
#define IS_REDUCED_FLOAT(t) (IS_BFLOAT(t) || IS_FLOAT8(t))

