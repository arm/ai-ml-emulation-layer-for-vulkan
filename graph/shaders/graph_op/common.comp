// Interpret integer bits at their original width before widening. Type tags
// describe TOSA arithmetic; tensor storage may use either SINT or UINT formats.
#define DECODE_STORAGE_TO_COMP(rawValue, typeTag, compType) \
    (IS_FLOAT8(typeTag) ? compType(decode_float8_to_f16(uint8_t(rawValue), typeTag)) : \
     IS_BFLOAT(typeTag) ? compType(decode_to_f32(bfloat16_t(rawValue))) : \
     (typeTag) == TYPE_INT8 ? compType(int8_t(rawValue)) : \
     (typeTag) == TYPE_INT16 ? compType(int16_t(rawValue)) : \
     (typeTag) == TYPE_INT32 ? compType(int32_t(rawValue)) : \
     (typeTag) == TYPE_INT64 ? compType(int64_t(rawValue)) : compType(rawValue))

// Both variants round FP8 to nearest-even directly from FP32. This variant
// truncates BF16; ENCODE_COMP_TO_STORAGE_RNE rounds BF16 to nearest-even.
// Explicit storage casts keep inactive branches valid for integer and bool
// shaders too; overload resolution must never select a reduced-float encoding.
#define ENCODE_COMP_TO_STORAGE(compValue, storageType, typeTag) \
    (IS_FLOAT8(typeTag) ? storageType(encode_float8_rne(float(compValue), typeTag)) : \
     IS_BFLOAT(typeTag) ? storageType(encode_from_f32(float(compValue), bfloat16_t(0))) : \
     (typeTag) == TYPE_INT8 ? storageType(int8_t(compValue)) : \
     (typeTag) == TYPE_INT16 ? storageType(int16_t(compValue)) : \
     (typeTag) == TYPE_INT32 ? storageType(int32_t(compValue)) : \
     (typeTag) == TYPE_INT64 ? storageType(int64_t(compValue)) : storageType(compValue))

// Same storage conversions as above, except BF16 uses round-to-nearest-even.
#define ENCODE_COMP_TO_STORAGE_RNE(compValue, storageType, typeTag) \
    (IS_FLOAT8(typeTag) ? storageType(encode_float8_rne(float(compValue), typeTag)) : \
     IS_BFLOAT(typeTag) ? storageType(encode_from_f32_rne(float(compValue), bfloat16_t(0))) : \
     (typeTag) == TYPE_INT8 ? storageType(int8_t(compValue)) : \
     (typeTag) == TYPE_INT16 ? storageType(int16_t(compValue)) : \
     (typeTag) == TYPE_INT32 ? storageType(int32_t(compValue)) : \
     (typeTag) == TYPE_INT64 ? storageType(int64_t(compValue)) : storageType(compValue))

#define CONV_TO_ACC_INPUT(value) DECODE_STORAGE_TO_COMP(value, TYPE_IN, ACC_T)
#define CONV_TO_ACC_WEIGHT(value) DECODE_STORAGE_TO_COMP(value, TYPE_WEIGHT, ACC_T)
#define CONV_TO_ACC_BIAS(value) DECODE_STORAGE_TO_COMP(value, TYPE_OUT, ACC_T)
#define CONV_ACC_TO_OUT(value) ENCODE_COMP_TO_STORAGE(value, OUT_T, TYPE_OUT)
