#define IN_T %in_t_storage%
#define OUT_T %out_t_storage%
#define IN_COMP_T %in_t_comp%
#define OUT_COMP_T %out_t_comp%
#define TYPE_IN %in_t_type%
#define TYPE_OUT %out_t_type%
#define TYPE_IN_MIN %in_t_lowest%
#define TYPE_IN_MAX %in_t_max%
#define TYPE_OUT_MIN %out_t_lowest%
#define TYPE_OUT_MAX %out_t_max%

layout(local_size_x = %warpX%) in;

layout(constant_id = 0) const uint32_t RANK = RANK_MAX;

layout(set = 0, binding = 0) uniform tensorARM<OUT_T, RANK> outputData;
layout(set = 1, binding = 0) uniform tensorARM<IN_T, RANK> inputData;

void main() {
    uint[RANK] index;
    getIndex(outputData, index);
    IN_T rawValue;
    tensorReadARM(inputData, index, rawValue);
    IN_COMP_T value = DECODE_STORAGE_TO_COMP(rawValue, TYPE_IN, IN_COMP_T);

#if IS_BOOL(TYPE_OUT)
    OUT_T outValue = OUT_T(value != IN_COMP_T(0));
#elif TYPE_OUT == TYPE_HALF
    // Native FP16 conversions can saturate on overflow. TOSA requires infinity
    // after rounding overflows the destination range. The RNE boundary is 65520,
    // halfway between the largest finite FP16 value (65504) and 65536.
    OUT_T outValue;
    if (float(value) >= 65520.0) {
        outValue = OUT_T(INF);
    } else if (float(value) <= -65520.0) {
        outValue = OUT_T(-INF);
    } else {
#if IS_INTEGER(TYPE_IN)
        // Every integer in this range is exact in FP32. Round its 23 fraction
        // bits to FP16's 10 using RNE, so the final native conversion is exact
        // even on devices that convert integers to FP16 using round-to-zero.
        uint rawFloatValue = floatBitsToUint(float(value));
        uint roundedValue = (rawFloatValue + 0xFFFu + ((rawFloatValue >> 13) & 1u)) & ~0x1FFFu;
        outValue = OUT_T(uintBitsToFloat(roundedValue));
#else
        outValue = OUT_T(value);
#endif
    }
#elif IS_INTEGER(TYPE_OUT) && (IS_FLOAT(TYPE_IN) || IS_REDUCED_FLOAT(TYPE_IN))
    float fvalue = float(value);
    OUT_T outValue;
    if (fvalue <= float(TYPE_OUT_MIN)) {
        outValue = OUT_T(OUT_COMP_T(TYPE_OUT_MIN));
    } else if (fvalue >= float(TYPE_OUT_MAX)) {
        outValue = OUT_T(OUT_COMP_T(TYPE_OUT_MAX));
    } else {
        outValue = OUT_T(OUT_COMP_T(roundEven(fvalue)));
    }
#else
    OUT_T outValue = ENCODE_COMP_TO_STORAGE_RNE(value, OUT_T, TYPE_OUT);
#endif
    tensorWriteARM(outputData, index, outValue);
}
