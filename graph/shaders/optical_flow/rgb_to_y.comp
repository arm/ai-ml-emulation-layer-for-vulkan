#version 450
precision highp float;
precision highp sampler2D;
precision highp image2D;
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

/*
RGB to Y color conversion + downsampling
  - Input image : Full size RGB(3 or 4 ch) or Luma(1ch)
  - Output images : Downsampled Luma, plus Full size Luma when OUTPUT_FULL
  - If OUTPUT_FULL, DOWNSAMPLE_SCALE must be 2.f (hard-coded)
  - Full size Luma is processed in 2x2 pixels per thread. Vectorization is not configurable.
  - Downsampling is a 2x2 box filter
*/

#ifndef OUTPUT_FULL
#error OUTPUT_FULL must be defined
#endif
#ifndef IMAGE_STORE
#error IMAGE_STORE must be defined
#endif

// Local Work Size set as Specialization Constants
layout (local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;

layout(constant_id = 2) const bool LUMA_INPUT = false;
layout(constant_id = 3) const float DOWNSAMPLE_SCALE_X = 2.f;  // If OUTPUT_FULL, fixed to 2.f
layout(constant_id = 4) const float DOWNSAMPLE_SCALE_Y = 2.f;  // If OUTPUT_FULL, fixed to 2.f
layout(constant_id = 5) const int DS_OUTPUT_SIZE_X = 960;
layout(constant_id = 6) const int DS_OUTPUT_SIZE_Y = 540;
layout(constant_id = 7) const uint DS_STRIDE_DST = 960;   // The number of elements in a row (x-axis) including padding
layout(constant_id = 8) const int FULL_OUTPUT_SIZE_X = 1920;
layout(constant_id = 9) const int FULL_OUTPUT_SIZE_Y = 1080;
layout(constant_id = 10) const uint FULL_STRIDE_DST = 1920;   // The number of elements in a row (x-axis) including padding
layout(constant_id = 11) const bool UNORM8_INPUT = true;

layout (binding = 0) uniform sampler2D imageSampler;

#if IMAGE_STORE
layout (set=0, binding = 1, r8) uniform writeonly image2D dst_ds_img;
#else
layout (set = 0, binding = 2, std430) buffer _dst_ds_buf{
    uint8_t dst_ds_buf[];
};
#endif

#if OUTPUT_FULL
layout (set = 0, binding = 3, std430) buffer _dst_full_buf{
    uint8_t dst_full_buf[];
};
#endif

ivec2 clamp_input_pos(ivec2 pos)
{
    return clamp(pos, ivec2(0), textureSize(imageSampler, 0) - 1);
}

vec3 load_rgb(ivec2 pos)
{
    return texelFetch(imageSampler, clamp_input_pos(pos), 0).rgb;
}

uvec3 load_unorm8_rgb(ivec2 pos)
{
    return uvec3(floor(load_rgb(pos) * 255.f + 0.5f));
}

uint rgb_to_y_unorm8(uvec3 rgb)
{
    return (rgb.r + 2u * rgb.g + rgb.b + 2u) / 4u;
}

uvec3 load_unorm16_rgb(ivec2 pos)
{
    // Canonicalize packed-float input before weighted arithmetic. This remains within
    // one R8 level of the float formula while avoiding driver-dependent rounding.
    return uvec3(floor(load_rgb(pos) * 65535.f + 0.5f));
}

uint rgb_to_y_unorm16(uvec3 rgb)
{
    const uint weighted = rgb.r + 2u * rgb.g + rgb.b;
    return (weighted * 255u + 131070u) / 262140u;
}

uint load_luma_unorm8(ivec2 pos)
{
    if (LUMA_INPUT) {
        return load_unorm8_rgb(pos).r;
    }
    return rgb_to_y_unorm8(load_unorm8_rgb(pos));
}

uint load_luma(ivec2 pos)
{
    if (UNORM8_INPUT) {
        return load_luma_unorm8(pos);
    }
    return rgb_to_y_unorm16(load_unorm16_rgb(pos));
}

uint calc_downsampled_luma(ivec2 base_pos)
{
    if (UNORM8_INPUT) {
        if (LUMA_INPUT) {
            uint sum = load_luma_unorm8(base_pos) + load_luma_unorm8(base_pos + ivec2(1, 0)) +
                       load_luma_unorm8(base_pos + ivec2(0, 1)) + load_luma_unorm8(base_pos + ivec2(1, 1));
            return (sum + 2u) / 4u;
        }

        uvec3 sum = load_unorm8_rgb(base_pos) + load_unorm8_rgb(base_pos + ivec2(1, 0)) +
                    load_unorm8_rgb(base_pos + ivec2(0, 1)) + load_unorm8_rgb(base_pos + ivec2(1, 1));
        return (sum.r + 2u * sum.g + sum.b + 8u) / 16u;
    }

    uvec3 sum = load_unorm16_rgb(base_pos) + load_unorm16_rgb(base_pos + ivec2(1, 0)) +
                load_unorm16_rgb(base_pos + ivec2(0, 1)) + load_unorm16_rgb(base_pos + ivec2(1, 1));
    const uint weighted = sum.r + 2u * sum.g + sum.b;
    return (weighted * 255u + 524280u) / 1048560u;
}

void main()
{
    const ivec2 ds_pos = ivec2(gl_GlobalInvocationID.x,
                               gl_GlobalInvocationID.y);

    if (any(greaterThanEqual(ds_pos, ivec2(DS_OUTPUT_SIZE_X, DS_OUTPUT_SIZE_Y)))) return;

    // The pipeline currently uses a fixed 2x reduction. Keep the specialization constants
    // in the interface so the contract remains explicit.
    const ivec2 downsample_scale = ivec2(DOWNSAMPLE_SCALE_X, DOWNSAMPLE_SCALE_Y);
    const ivec2 src_base = ds_pos * downsample_scale;
    const uint luma_ds = calc_downsampled_luma(src_base);

    #if (IMAGE_STORE)
        imageStore(dst_ds_img, ds_pos, vec4(float(luma_ds) / 255.f, 0, 0, 0));
    #else
        dst_ds_buf[DS_STRIDE_DST * ds_pos.y + ds_pos.x] = uint8_t(luma_ds);
    #endif

    #if (OUTPUT_FULL)
        for (int qy = 0; qy < 2 && ds_pos.y * 2 + qy < FULL_OUTPUT_SIZE_Y; ++qy) {
            for (int qx = 0; qx < 2 && ds_pos.x * 2 + qx < FULL_OUTPUT_SIZE_X; ++qx) {
                ivec2 full_pos = ds_pos * 2 + ivec2(qx, qy);
                dst_full_buf[FULL_STRIDE_DST * full_pos.y + full_pos.x] = uint8_t(load_luma(full_pos));
            }
        }
    #endif
}
