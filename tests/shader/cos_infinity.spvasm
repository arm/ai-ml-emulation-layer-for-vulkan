               OpCapability GraphARM
               OpCapability TensorsARM
               OpCapability Shader
               OpCapability VulkanMemoryModel
               OpExtension "SPV_ARM_graph"
               OpExtension "SPV_ARM_tensors"
               OpExtension "SPV_KHR_vulkan_memory_model"
         %tosa = OpExtInstImport "TOSA.001000.1"
               OpMemoryModel Logical Vulkan
               OpDecorate %input Binding 0
               OpDecorate %input DescriptorSet 0
               OpDecorate %output Binding 1
               OpDecorate %output DescriptorSet 0
        %float = OpTypeFloat 32
         %uint = OpTypeInt 32 0
       %uint_1 = OpConstant %uint 1
       %uint_2 = OpConstant %uint 2
       %shape = OpTypeArray %uint %uint_1
       %dims = OpConstantComposite %shape %uint_2
      %tensor = OpTypeTensorARM %float %uint_1 %dims
   %tensor_ptr = OpTypePointer UniformConstant %tensor
        %input = OpVariable %tensor_ptr UniformConstant
       %output = OpVariable %tensor_ptr UniformConstant
        %graph_type = OpTypeGraphARM 1 %tensor %tensor
       %zero = OpConstant %uint 0
               OpGraphEntryPointARM %graph "tosa_cos_infinity" %input %output
        %graph = OpGraphARM %graph_type
          %arg = OpGraphInputARM %tensor %zero
       %result = OpExtInst %tensor %tosa COS %arg
               OpGraphSetOutputARM %result %zero
               OpGraphEndARM
